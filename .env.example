STEAM_ACCOUNT_NAME=
STEAM_PASSWORD=
STEAM_SHARED_SECRET=
STEAM_IDENTITY_SECRET=
DATABASE_URL=mysql://user:pass@host:3306/dbname
API_PORT=3000
# 0.0.0.0 = listen on all interfaces (public); 127.0.0.1 = local only
API_HOST=0.0.0.0
# Use X-Bot-Secret or Authorization: Bearer (same value)
API_SECRET=shared-secret-with-sm-plugin
BOT_ADMINS=76561198000000000
REMOVE_FRIEND_AFTER_DELIVERY=true

# Optional: Discord webhook for private admin/ops notifications (lifecycle, errors, trade outcomes)
DISCORD_WEBHOOK_ADMIN=
# Optional: Discord webhook for public donation announcements
DISCORD_WEBHOOK_DONATIONS=
# Days before an admin-initiated unclaimed delivery is auto-cancelled (default: 7)
MANUAL_DELIVERY_EXPIRY_DAYS=7
# Optional: backpack.tf legacy API key for item pricing (get it from https://backpack.tf/developer)
BACKPACK_TF_API_KEY=
